+// BT2 Recomp patch: a 2D primitive (a sprite, or a flat triangle without perspective) drawn with a texture
+// replacement. Its samples take their own texture coordinates (TEX_PER_SAMPLE_BIT: triangle_setup.comp centres
+// them and leaves them unsnapped; binning draws its tiles super-sampled), held inside the primitive's own
+// texels (the middles of its edge texels: a texture entry of its own, region-clamped), so neither a sample nor
+// the filter reaches the neighbouring art of the sheet. A magnified primitive is filtered linearly, as the
+// replacement has the detail. One whose coordinates leave the texture (a repeated pattern) keeps the texture's
+// own wrapping.
+template <bool quad>
+uint32_t GSInterface::replacement_2d_texture(uint32_t tex, uint32_t tex_index, const VertexPosition *pos,
+                                             const VertexAttribute *attr, const ContextState &ctx, const PRIMBits &prim)
+{
+	constexpr unsigned count = quad ? 2 : 3;
+	tex |= TEX_PER_SAMPLE_BIT;
+
+	// Inclusive: the texels the primitive shows.
+	ivec4 own;
+	compute_uv_bb<quad, count, false>(attr, ctx, prim, own, nullptr, nullptr);
+	const int width = 1 << int(ctx.tex0.desc.TW), height = 1 << int(ctx.tex0.desc.TH);
+	if (own.x < 0 || own.y < 0 || own.z >= width || own.w >= height || own.z < own.x || own.w < own.y)
+		return tex;
+
+	// Texels per pixel, from the extents (2D art is drawn upright).
+	ivec2 lo = pos[0].pos, hi = pos[0].pos;
+	for (unsigned i = 1; i < count; i++)
+	{
+		lo = muglm::min(lo, pos[i].pos);
+		hi = muglm::max(hi, pos[i].pos);
+	}
+	const float pixels_x = float(hi.x - lo.x) / float(1 << PGS_SUBPIXEL_BITS);
+	const float pixels_y = float(hi.y - lo.y) / float(1 << PGS_SUBPIXEL_BITS);
+	const bool magnified = (pixels_x > 0.0f && float(own.z - own.x + 1) < 0.75f * pixels_x) ||
+	                       (pixels_y > 0.0f && float(own.w - own.y + 1) < 0.75f * pixels_y);
+
+	if (render_pass.piece_source != tex_index || any(notEqual(render_pass.piece_region, own)))
+	{
+		TextureInfo piece = render_pass.tex_infos[tex_index];
+		piece.info.region = vec4(float(own.x), float(own.y), float(own.z), float(own.w));
+		render_pass.piece_index = uint32_t(render_pass.tex_infos.size());
+		render_pass.piece_source = tex_index;
+		render_pass.piece_region = own;
+		render_pass.tex_infos.push_back(piece);
+		render_pass.tex0_infos.push_back(render_pass.tex0_infos[tex_index]);
+		render_pass.held_images.push_back(render_pass.held_images[tex_index]);
+	}
+
+	tex &= ~uint32_t(((1u << TEX_TEXTURE_INDEX_BITS) - 1u) << TEX_TEXTURE_INDEX_OFFSET);
+	tex |= render_pass.piece_index << TEX_TEXTURE_INDEX_OFFSET;
+	tex |= TEX_SAMPLER_CLAMP_S_BIT | TEX_SAMPLER_CLAMP_T_BIT;
+	if (magnified)
+		tex |= TEX_SAMPLER_MAG_LINEAR_BIT;
+	return tex;
+}
