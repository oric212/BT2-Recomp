+// BT2 Recomp patch: whether a sprite copies its texture 1:1 (texture coordinates in step with the pixels) from
+// texels 1 to 4 whole pixels away from the pixel it draws, as the GS samples it (at the pixel's top-left corner):
+// a neighbour comparison, as edge filters do. Larger offsets are left alone (16-bit views of 32-bit data are
+// read 8 texels away by their layout).
+bool GSInterface::neighbour_read(const VertexPosition *pos, const VertexAttribute *attr, const PRIMBits &prim) const
+{
+	if (!prim.FST)
+		return false;
+	const ivec2 dpos = pos[1].pos - pos[0].pos;
+	const ivec2 duv = ivec2(attr[1].uv) - ivec2(attr[0].uv);
+	if (any(greaterThan(muglm::abs(duv - dpos), ivec2(1 << PGS_SUBPIXEL_BITS))))
+		return false;
+	for (int axis = 0; axis < 2; axis++)
+	{
+		const int texels = (int(attr[0].uv[axis]) - pos[0].pos[axis]) >> PGS_SUBPIXEL_BITS; // Floor.
+		if (texels != 0 && texels >= -4 && texels <= 4)
+			return true;
+	}
+	return false;
+}
