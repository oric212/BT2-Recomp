index 9f05da8..ecf6336 100644
--- a/gs/gs_interface.hpp
+++ b/gs/gs_interface.hpp
@@ -12,6 +12,7 @@
 #include "intrusive_hash_map.hpp"
 #include "dynamic_array.hpp"
 #include <stddef.h>
+#include <functional>
 #include <vector>
 #include <type_traits>
 
@@ -303,6 +304,15 @@ public:
 
 	void read_transfer_fifo(void *data, uint32_t num_128b_words);
 
+	// Texture replacement (BT2 Recomp patch): called when a render pass first uses a texture. A non-null
+	// image holds the whole 2^TW x 2^TH texture at a higher resolution, with mips down to the texture's own
+	// size, in a block-compressed format. When `exact` (made with the texture's current palette, or one
+	// without a palette) it is drawn instead of the texture; otherwise (another palette's version) as
+	// detail: the texture's colour (bilinear, the game's current palette) times the replacement's brightness
+	// over its brightness at the texture's size, and alpha alike, so colours and lighting stay the game's.
+	// Textures with super-samples get none.
+	std::function<Vulkan::ImageHandle (const TextureDescriptor &, bool &exact)> texture_replacement;
+
 private:
 	friend class PageTracker;
 	void flush(PageTrackerFlushFlags flags, FlushReason reason);
diff --git a/gs/shaders/data_structures.h b/gs/shaders/data_structures.h
index 62882ab..80d71f4 100644
--- a/gs/shaders/data_structures.h
+++ b/gs/shaders/data_structures.h
@@ -106,6 +106,13 @@ struct TexInfo
 
 CONSTEXPR int TEX_INFO_FORCE_SAMPLE_MAPPING = 0x1;
 CONSTEXPR int TEX_INFO_LONG_TERM_REFERENCE = 0x2;
+// BT2 Recomp patch: a texture's detail texture (its slot + 1; 0 for none) and that texture's mip level at
+// the texture's own size.
+CONSTEXPR int TEX_INFO_DETAIL_INDEX_OFFSET = 8;
+CONSTEXPR int TEX_INFO_DETAIL_INDEX_BITS = 11;
+CONSTEXPR int TEX_INFO_DETAIL_LOD_OFFSET = 19;
+CONSTEXPR int TEX_INFO_DETAIL_LOD_BITS = 4;
+CONSTEXPR int TEX_INFO_DETAIL_EXACT = 1 << 23; // The replacement is drawn instead of the texture.
 
 CONSTEXPR int PGS_FB_SWIZZLE_WIDTH_LOG2 = 3;
 CONSTEXPR int PGS_FB_SWIZZLE_HEIGHT_LOG2 = 3;
diff --git a/gs/shaders/ubershader.comp b/gs/shaders/ubershader.comp
index 33be934..b82285d 100644
--- a/gs/shaders/ubershader.comp
+++ b/gs/shaders/ubershader.comp
@@ -1254,6 +1254,34 @@ vec4 sample_texture(uint tex_word, uint filtering, vec2 uv, float q, bool perspe
 		color = roundEven(((16.0 - weight) * color + color_2 * weight) * (1.0 / 16.0));
 	}
 
+	// BT2 Recomp patch: a texture pack's replacement. Made with the current palette, it is drawn instead of
+	// the texture; made with another palette (the fighters' lit palettes change every frame), it adds its
+	// detail to the game's own colours: the texture's colour (bilinear) times the replacement's brightness
+	// over its brightness at the texture's size, and alpha alike.
+	int detail = bitfieldExtract(tex_info.flags, TEX_INFO_DETAIL_INDEX_OFFSET, TEX_INFO_DETAIL_INDEX_BITS);
+	if (detail != 0)
+	{
+		uint detail_index = uint(detail - 1);
+		vec2 texel = perspective ? uv * size.xy : uv;
+		vec2 detail_uv = texel * texture_info.data[detail_index].sizes.zw;
+		vec4 high = textureLod(sampler2D(bindless_textures[detail_index], linear_sampler), detail_uv, LOD_1);
+		if ((tex_info.flags & TEX_INFO_DETAIL_EXACT) != 0)
+		{
+			color = roundEven(255.0 * high);
+		}
+		else
+		{
+			float detail_level = float(bitfieldExtract(tex_info.flags, TEX_INFO_DETAIL_LOD_OFFSET, TEX_INFO_DETAIL_LOD_BITS));
+			vec4 high_at_size = textureLod(sampler2D(bindless_textures[detail_index], linear_sampler), detail_uv, LOD_1 + detail_level);
+			vec4 own = textureLod(sampler2D(bindless_textures[tex_index], linear_sampler), uv_1, LOD_1);
+			const vec3 LUMA = vec3(0.299, 0.587, 0.114);
+			const float DETAIL_EPSILON = 1.0 / 64.0;
+			float brightness = (dot(high.rgb, LUMA) + DETAIL_EPSILON) / (dot(high_at_size.rgb, LUMA) + DETAIL_EPSILON);
+			float alpha = (high.a + DETAIL_EPSILON) / (high_at_size.a + DETAIL_EPSILON);
+			color = roundEven(255.0 * clamp(vec4(own.rgb * brightness, own.a * alpha), 0.0, 1.0));
+		}
+	}
+
 	return color;
 }
 
